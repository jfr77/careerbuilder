# Frontend build-time config (Vite inlines VITE_* vars at build).
# Copy to frontend/.env.local for local dev, or set these in the GitHub Pages
# build (see .github/workflows/deploy-pages.yml).

# Backend API origin.
#  - Local dev: leave UNSET. Paths stay relative and the Vite proxy forwards
#    /api to the backend (the Makefile passes VITE_API_URL for the proxy).
#  - GitHub Pages: set to the deployed backend URL, e.g. your Render service.
# VITE_API_URL=https://carreerbuilder-api.onrender.com

# Supabase Auth (PUBLIC values — safe to ship in the bundle). When BOTH are set
# the login screen is shown and a Bearer token is attached to every API call.
# When unset, auth is skipped (pair with a backend running AUTH_DISABLED=1).
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon-public-key>

# Base path for GitHub Pages project sites (served under /<repo>/). Leave unset
# ('/') for local dev or a root-domain deploy.
# VITE_BASE=/carreerbuilder/
